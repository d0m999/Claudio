    "onboarding.failure.helper-unavailable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The bundled helper was not found, so nothing was changed. Open claudi0 from Applications and try again." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没找到 claudi0 随身带的那个小助手，所以什么都没有改动。请从「应用程序」里打开 claudi0 再试一次。" } }
