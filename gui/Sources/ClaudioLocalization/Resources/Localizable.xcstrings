    "ai-cue.credential.key-label" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "API Key" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "API Key" } }
      }
    },
    "ai-cue.credential.privacy" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your sound description and generation instructions are sent directly to ElevenLabs. ElevenLabs may charge your account for generation. Retention and model-improvement use follow your ElevenLabs account and their terms." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "声音描述和生成指令会由本机直接发送给 ElevenLabs；生成可能由 ElevenLabs 向你的账户收费；数据留存及是否用于模型改进，以你的 ElevenLabs 账户设置和其条款为准。" } }
      }
    },
    "ai-cue.credential.privacy.minimax" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your sound description, Mandarin speech, and generation metadata are sent directly to MiniMax's global service. Generation may consume your MiniMax quota. Data retention and model-improvement use follow MiniMax's terms. Saving first runs a read-only voice-list probe and does not generate audio." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "声音描述、普通话台词和生成元数据会由本机直接发送给 MiniMax 全球服务；生成可能消耗你的 MiniMax 配额；数据留存及是否用于模型改进以 MiniMax 条款为准。保存前只执行不生成音频的 voice-list 只读检查。" } }
      }
    },
    "ai-cue.credential.privacy.qwen-singapore" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your sound description, speech, and generation metadata are sent directly to DashScope in Singapore under that region's data-processing, retention, and model-improvement terms. Saving makes no model request and costs no generation quota; the next explicit generation may consume quota and validates this region's separate key." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "声音描述、台词和生成元数据会由本机直接发送给新加坡地区的 DashScope，并适用该地区的数据处理、留存及模型改进条款。保存不发模型请求且不消耗生成配额；下一次显式生成可能消耗配额，并验证此地区的独立 Key。" } }
      }
    },
    "ai-cue.credential.privacy.qwen-beijing" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your sound description, speech, and generation metadata are sent directly to DashScope in Beijing under that region's data-processing, retention, and model-improvement terms. Saving makes no model request and costs no generation quota; the next explicit generation may consume quota and validates this region's separate key." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "声音描述、台词和生成元数据会由本机直接发送给北京地区的 DashScope，并适用该地区的数据处理、留存及模型改进条款。保存不发模型请求且不消耗生成配额；下一次显式生成可能消耗配额，并验证此地区的独立 Key。" } }
      }
    },
    "ai-cue.credential.keychain" : {
      "localizations" : {
