        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "文件已导入但未能分配给事件；旧提示音仍有效，可在声音包中管理这个未分配文件。" } }
      }
    },
    "ai-cue.error.adoption" : {
