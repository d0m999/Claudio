      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter a name before applying a candidate." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "采用候选前，请填写提示音名称。" } }
      }
    },
    "ai-cue.error.name-invalid" : {
