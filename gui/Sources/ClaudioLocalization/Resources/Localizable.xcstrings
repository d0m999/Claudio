      }
    },
    "ai-cue.error.credential-unavailable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The API Key could not be read or saved in Keychain. Try again after unlocking this Mac." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法在钥匙串中读取或保存 API Key；请解锁这台 Mac 后重试。" } }
      }
