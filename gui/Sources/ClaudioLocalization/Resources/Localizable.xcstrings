        "en" : { "stringUnit" : { "state" : "translated", "value" : "The small helper that plays sounds is not installed. Choose Repair and claudi0 will add it without changing anything else." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "负责放声音的小助手还没装上。点一下，claudi0 会帮你补上，其它设置都不会动。" } }
      }
    },
    "onboarding.settings-not-writable.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "We cannot change these settings yet" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这份设置我们暂时改不了" } }
      }
    },
    "onboarding.settings-not-writable.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code's configuration file is not writable right now. claudi0 will not force it. Fix the permission, then choose Redetect." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code 的配置文件目前不允许写入，claudi0 不会硬闯。改好权限后，回来点一下重新检测。" } }
      }
    },
    "onboarding.settings-parse-failure.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The configuration looks unusual" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "配置文件看着有点乱" } }
      }
    },
    "onboarding.settings-parse-failure.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code's configuration format is not what claudi0 expected, so it stopped without touching the file. Check it, then return and choose Redetect." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code 的配置文件格式跟预期不太一样，claudi0 怕越改越乱，先停手没有碰它。检查一下这个文件，弄好后回来点一下重新检测。" } }
      }
    },
    "onboarding.not-installed.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Give Claude Code a voice" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "让 Claude Code 学会开口" } }
      }
    },
    "onboarding.not-installed.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "After setup, you will hear cues when work finishes, a response is needed, or execution is interrupted. Your existing settings stay in place, with an automatic backup you can undo at any time." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "接上以后，干完活、要你确认、被打断了都会有声音提示——不用回头盯屏幕也知道进度。原来的其它设置都会保留，还会自动留一份备份，随时可以一键撤销。" } }
      }
    },
    "onboarding.installed.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Everything is connected" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已经接好了" } }
      }
    },
    "onboarding.installed.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code now plays the matching sound when work finishes, a response is needed, or execution is interrupted." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "现在 Claude Code 干完活、要确认、被打断了都会响对应的声音。" } }
      }
    },
