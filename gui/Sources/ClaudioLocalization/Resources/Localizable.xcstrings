    "onboarding.failure.helper-unavailable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The bundled helper was not found, so nothing was changed. Open claudi0 from Applications and try again." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没找到 claudi0 随身带的那个小助手，所以什么都没有改动。请从「应用程序」里打开 claudi0 再试一次。" } }
      }
    },
    "onboarding.failure.setup" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This step could not finish. claudi0 stopped without changing Claude Code's configuration. View the reason below, or try again to continue safely." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这一步没能完成。claudi0 已经停下，没有改动 Claude Code 的配置。看看下面的原因，或者再点一次 —— 它会接着上次继续，不会重复安装。" } }
      }
    },
    "onboarding.failure.disconnect" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not disconnect; your configuration was not changed. View the reason below, or try again later." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没能断开，你的配置一个字都没动。看看下面的原因，或者稍后再试一次。" } }
      }
    },
    "onboarding.failure.disconnect-nothing" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not disconnect: claudi0 could not recognize the settings it previously added, so it stopped without changing anything." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没能断开：claudi0 没能认出自己之前留下的设置，所以停手了，什么都没改。" } }
      }
    },
    "onboarding.notice.salvaged" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The sound pack “%@” could not be read, likely because an earlier install was interrupted. claudi0 moved it intact to %@ — no files were deleted — and installed a clean copy." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "「%@」这个声音包读不出来了（多半是上一次安装被中断留下的残骸）。claudi0 把它原样搬到了 %@ —— 一个文件都没删 —— 并重新装了一份干净的。" } }
      }
    },
    "onboarding.notice.repaired" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your previously selected pack “%@” is no longer available, so claudi0 selected “%@” for now. It may not include every event. The event rows show what is missing, and you can choose another pack below." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你之前选的「%@」已经不在了，claudi0 先替你换成了「%@」。它未必每个事件都有声音，事件行里会标出哪些还缺。你随时可以在下面的声音包里换成别的。" } }
      }
