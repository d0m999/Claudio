# gstack local tool artifacts (browse logs, session state) — not project source
.gstack/

# macOS
.DS_Store

# Xcode / Swift (for when helper/ and gui/ land)
.build/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# Local dev app bundle — ad-hoc signed, rebuilt on demand, never committed
dist/

# Personal/IP-protected sound packs (e.g. game character cries) — never commit or distribute
local-packs/

# Workflow 用的临时 worktree（Agent isolation: worktree）
.claude/worktrees/
